# Base de datos
# Usa la conexión de Supabase (Project Settings > Database > Connection string)
# o una PostgreSQL local.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestion_restaurante?schema=public"

# Para el adapter de Supabase (opcional, si usas Auth/Storage)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# API
PORT=3001
CORS_ORIGIN=http://localhost:3000

# Auth JWT
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRES_IN=7d

# OpenRouter (Asistente IA)
OPENROUTER_API_KEY=
OPENROUTER_SITE_URL=https://gesti-n-restaurante-web.vercel.app
OPENROUTER_APP_NAME=Gestion Restaurante